pipeline {
    agent {
        node {
            label 'Agent-1'
        }
    }
    environment {
        Greeting = 'Arun'
        //  packageVersion = ''
    }
    options {
        timeout(time:1, unit:'HOURS' )
    }
    parameters {
        string (name:'version', defaultValue: '', description:'what is Application artifact Version ?')
        string (name:'environment', defaultValue: '', description:'What is the environment ?')
    }
    stages {
        stage('Print Version') {
            steps {
                sh """
                    echo "version : ${params.version}"
                    echo "environment : ${params.environment}"
                """
            }
        }
    }
}